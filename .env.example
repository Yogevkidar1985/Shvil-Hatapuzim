# ===== מסד נתונים =====
# ברירת מחדל: SQLite מקומי. לפרודקשן עברו ל-PostgreSQL (Supabase / Neon):
# DATABASE_URL="postgresql://user:pass@host:5432/dbname?schema=public"
DATABASE_URL="file:./dev.db"

# ===== GreenAPI (WhatsApp) — סודות בצד שרת בלבד! =====
# מתקבלים בקונסולת GreenAPI שלכם. אסור לחשוף בצד לקוח ואסור לעשות commit לערכים אמיתיים.
GREENAPI_ID_INSTANCE=""
GREENAPI_API_TOKEN=""
GREENAPI_API_URL="https://api.green-api.com"
GREENAPI_MEDIA_URL="https://media.green-api.com"

# טוקן אימות לוובהוק הנכנס מ-GreenAPI (אופציונלי — מומלץ להגדיר ב-GreenAPI כ-webhookUrlToken)
GREENAPI_WEBHOOK_TOKEN=""

# ===== אבטחת גישה למערכת =====
# סיסמת כניסה בסיסית למערכת (login). שנו לערך חזק.
APP_PASSWORD="changeme"
# מחרוזת אקראית ארוכה לחתימת קוקי הסשן.
SESSION_SECRET="please-change-this-to-a-long-random-string"
